  "description": "A tiny native Windows companion for Codex allowance monitoring",
  "license": "MIT",
  "scripts": {
    "build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-native.ps1 -Package",
    "build:portable": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-native.ps1",
    "test": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-native.ps1 -Test",
    "test:legacy": "node --test tests/*.test.cjs",
    "qa": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/qa-native.ps1"
  }
}
